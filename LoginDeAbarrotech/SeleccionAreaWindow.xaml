<Window x:Class="LoginDeAbarrotech.SeleccionAreaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecciona tu área de interés" 
        Height="300" 
        Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Se detectó un empate entre las siguientes áreas. Por favor selecciona la que más te interese:"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <!-- AQUÍ ESTÁ EL CAMBIO: agregar x:Name="ListaAreas" -->
        <ListBox x:Name="ListaAreas" 
                 Grid.Row="1"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" 
                               FontSize="12"
                               Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" 
                Content="Continuar" 
                Click="BtnContinuar_Click"
                Width="100"
                Height="30"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>