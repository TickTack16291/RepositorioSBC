<Window x:Class="LoginDeAbarrotech.VisualizacionUsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Mi Información Personal" Height="580" Width="450"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        MinHeight="580" MinWidth="450">
    <Grid Background="#F5F5F5">
        <Border Background="White" CornerRadius="18" Padding="24" Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Título -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Mi Información Personal" FontSize="22" FontWeight="Bold"
                               Foreground="#1976D2" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <Separator Margin="0,0,0,12"/>
                </StackPanel>
                
                <!-- Información básica -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Usuario:" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="lblUsuario" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                    
                    <TextBlock Text="Nombre:" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="lblNombre" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                    
                    <TextBlock Text="Apellido Paterno:" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="lblApellidoPaterno" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                    
                    <TextBlock Text="Apellido Materno:" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="lblApellidoMaterno" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                    
                    <TextBlock Text="Preparatoria de Origen:" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="lblPreparatoriaOrigen" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                    
                    <TextBlock Text="Área Diagnosticada:" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="lblDiagnosticoArea" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                    
                    <TextBlock Text="Carrera Recomendada:" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="lblDiagnosticoCarrera" Margin="0,0,0,12" FontFamily="Segoe UI"/>
                </StackPanel>
                
                <!-- Comentarios (área expandible) -->
                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Comentarios del Experto:" FontWeight="Bold" Foreground="#1976D2" 
                               DockPanel.Dock="Top" Margin="0,0,0,5"/>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" DockPanel.Dock="Top">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="lblComentarios" Margin="8" TextWrapping="Wrap" 
                                       FontFamily="Segoe UI" MinHeight="60"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
                
                <!-- Botón Cerrar -->
                <Button Grid.Row="3" Content="Cerrar" Width="110" Height="36" Background="#1976D2" 
                        Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" 
                        Click="btnCerrar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>