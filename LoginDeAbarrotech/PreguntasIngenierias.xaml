<Page x:Class="LoginDeAbarrotech.PreguntasIngenierias"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LoginDeAbarrotech"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PreguntasIngenierias"
      Background="LightBlue">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" 
             Text="Cuestionario - PREGUNTAS INGENIERIAS" 
             FontSize="16" 
             FontWeight="Bold" 
             HorizontalAlignment="Center" 
             Margin="0,0,0,15"
             Foreground="#2C3E50"/>

        <!-- Área de preguntas con ScrollViewer - Esta es la parte que se desplaza -->
        <Border Grid.Row="1"
          BorderBrush="#BDC3C7"
          BorderThickness="1"
          CornerRadius="5"
          Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="5">
                <StackPanel x:Name="QuestionsPanel" Margin="5">
                    <!-- Las preguntas se generarán dinámicamente aquí -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Botón de envío - Siempre visible en la parte inferior -->
        <Button Grid.Row="2" 
          x:Name="BtnSubmit" 
          Content="Enviar Respuestas" 
          Click="BtnSubmit_Click"
          HorizontalAlignment="Center"
          Width="140"
          Height="35"
          FontSize="12"
          Background="#3498DB"
          Foreground="White"
          BorderBrush="#2980B9"/>
    </Grid>
</Page>
